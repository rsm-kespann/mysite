      "source": [
        "model.summary()"
      ],
      "id": "3b683fcc",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "::::\n",
        "\n",
        "\n",
        "##### Number of prior donations (freq)"
      ],
      "id": "b5006698"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "freq_treat = df[df['treatment'] == 1]['freq'].dropna()\n",
        "freq_ctrl = df[df['treatment'] == 0]['freq'].dropna()\n",
        "ttest1 = stats.ttest_ind(freq_treat, freq_ctrl, equal_var=False)\n",
        "\n",
        "print(f\"{'Statistic':<12} {'Value'}\")\n",
        "print(f\"{'-'*25}\")\n",
        "print(f\"{'t-statistic':<12} {ttest1.statistic:.4f}\")\n",
        "print(f\"{'p-value':<12} {ttest1.pvalue:.4f}\")"
