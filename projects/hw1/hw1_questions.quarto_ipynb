        "print(f\"Control mean:   ${amount_ctrl.mean():.2f}\")\n",
        "print(f\"T-statistic:    {ttest_amount.statistic:.4f}\")\n",
        "print(f\"P-value:        {ttest_amount.pvalue:.4f}\")"
